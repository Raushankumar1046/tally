'use client';

import React, { useEffect, useState } from 'react';
import Header from '@/components/Header';
import { api, Purchase, Vendor, Item, formatCurrency } from '@/lib/api';
import {
  ShoppingCart,
  Plus,
  Trash2,
  CheckCircle2,
  AlertTriangle,
  Building,
  Pencil,
  Boxes,
  Tag,
  X,
} from 'lucide-react';

interface PurchaseLine {
  itemId: string;
  quantity: number;
  unitPurchasePrice: number;
  taxRate: number;
}

export default function PurchasesPage() {
  const [purchases, setPurchases] = useState<Purchase[]>([]);
  const [vendors, setVendors] = useState<Vendor[]>([]);
  const [items, setItems] = useState<Item[]>([]);
  const [loading, setLoading] = useState(true);

  // Form State
  const [selectedVendorId, setSelectedVendorId] = useState('');
  const [invoiceNumber, setInvoiceNumber] = useState('');
  const [purchaseDate, setPurchaseDate] = useState<string>(new Date().toISOString().split('T')[0]);
  const [isCredit, setIsCredit] = useState(false);
  const [lines, setLines] = useState<PurchaseLine[]>([]);

  // Quick Add Vendor Modal State
  const [showAddVendorModal, setShowAddVendorModal] = useState(false);
  const [newVendorForm, setNewVendorForm] = useState({ name: '', phone: '', gstin: '', address: '' });
  const [addingVendor, setAddingVendor] = useState(false);

  // Quick Add / Edit Item Modal State
  const [showAddItemModal, setShowAddItemModal] = useState(false);
  const [targetLineIndex, setTargetLineIndex] = useState<number | null>(null);
  const [addingItem, setAddingItem] = useState(false);
  const [editingItem, setEditingItem] = useState<Item | null>(null);
  const [editingLineIndex, setEditingLineIndex] = useState<number | null>(null);

  const [itemForm, setItemForm] = useState({
    name: '',
    sku: '',
    category: '',
    unit: 'Pcs',
    purchaseQuantity: '1',
    purchasePrice: '',
    sellingPrice: '',
    taxRate: '18',
    minStockLevel: '5',
  });

  const [submitting, setSubmitting] = useState(false);
  const [message, setMessage] = useState<{ type: 'success' | 'error'; text: string } | null>(null);

  const fetchData = async () => {
    try {
      setLoading(true);
      const [purchasesData, vendorsData, itemsData] = await Promise.all([
        api.getPurchases(),
        api.getVendors(),
        api.getItems(),
      ]);
      setPurchases(purchasesData);
      setVendors(vendorsData);
      setItems(itemsData);

      if (vendorsData.length > 0 && !selectedVendorId) {
        setSelectedVendorId(vendorsData[0].id);
      }
    } catch (err: any) {
      console.error('Failed to load purchase data:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const generateAutoSku = () => 'SKU-' + Math.floor(100000 + Math.random() * 900000);

  const openAddItemModal = (lineIndex: number | null = null) => {
    setTargetLineIndex(lineIndex);
    setEditingItem(null);
    setEditingLineIndex(null);
    const existingQty = lineIndex !== null && lines[lineIndex] ? lines[lineIndex].quantity.toString() : '1';
    setItemForm({
      name: '',
      sku: generateAutoSku(),
      category: '',
      unit: 'Pcs',
      purchaseQuantity: existingQty,
      purchasePrice: '',
      sellingPrice: '',
      taxRate: '18',
      minStockLevel: '5',
    });
    setShowAddItemModal(true);
  };

  const openEditItemModal = (item: Item, lineIndex: number) => {
    setEditingItem(item);
    setEditingLineIndex(lineIndex);
    setTargetLineIndex(null);
    const existingQty = lines[lineIndex] ? lines[lineIndex].quantity.toString() : '1';
    setItemForm({
      name: item.name,
      sku: item.sku,
      category: item.category || '',
      unit: item.unit || 'Pcs',
      purchaseQuantity: existingQty,
      purchasePrice: item.purchasePrice !== undefined ? item.purchasePrice.toString() : '0',
      sellingPrice: item.sellingPrice !== undefined ? item.sellingPrice.toString() : '0',
      taxRate: item.taxRate !== undefined ? item.taxRate.toString() : '18',
      minStockLevel: item.minStockLevel !== undefined ? item.minStockLevel.toString() : '5',
    });
    setShowAddItemModal(true);
  };

  const addLine = () => {
    if (items.length === 0) {
      openAddItemModal(null);
      return;
    }
    const defaultItem = items[0];
    setLines([
      ...lines,
      {
        itemId: defaultItem.id,
        quantity: 1,
        unitPurchasePrice: Number(defaultItem.purchasePrice) || 0,
        taxRate: Number(defaultItem.taxRate) || 18.0,
      },
    ]);
  };

  const updateLine = (index: number, field: keyof PurchaseLine, value: any) => {
    if (field === 'itemId' && value === '__ADD_NEW__') {
      openAddItemModal(index);
      return;
    }

    const updated = [...lines];
    if (field === 'itemId') {
      const selectedItem = items.find((i) => i.id === value);
      updated[index] = {
        ...updated[index],
        itemId: value,
        unitPurchasePrice: selectedItem ? Number(selectedItem.purchasePrice) : updated[index].unitPurchasePrice,
        taxRate: selectedItem ? Number(selectedItem.taxRate) : 18.0,
      };
    } else {
      updated[index] = {
        ...updated[index],
        [field]: parseFloat(value) || 0,
      };
    }
    setLines(updated);
  };

  const removeLine = (index: number) => {
    setLines(lines.filter((_, idx) => idx !== index));
  };

  // Calculations
  const totalTaxable = lines.reduce((acc, line) => {
    return acc + (line.quantity || 0) * (line.unitPurchasePrice || 0);
  }, 0);

  const totalTaxAmount = lines.reduce((acc, line) => {
    const lineTaxable = (line.quantity || 0) * (line.unitPurchasePrice || 0);
    return acc + lineTaxable * ((line.taxRate || 18) / 100);
  }, 0);

  const totalPurchaseAmount = totalTaxable + totalTaxAmount;

  const handleAddVendorSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newVendorForm.name.trim()) return;
    try {
      setAddingVendor(true);
      const created = await api.createVendor(newVendorForm);
      setVendors((prev) => [created, ...prev]);
      setSelectedVendorId(created.id);
      setShowAddVendorModal(false);
      setNewVendorForm({ name: '', phone: '', gstin: '', address: '' });
    } catch (err: any) {
      alert(err.message || 'Failed to add vendor');
    } finally {
      setAddingVendor(false);
    }
  };

  const handleItemSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!itemForm.name.trim()) return;

    try {
      setAddingItem(true);
      const skuVal = itemForm.sku.trim() || generateAutoSku();

      if (editingItem) {
        // Update item in catalog
        const updated = await api.updateItem(editingItem.id, {
          name: itemForm.name.trim(),
          sku: skuVal,
          category: itemForm.category.trim() || undefined,
          unit: itemForm.unit || 'Pcs',
          purchasePrice: parseFloat(itemForm.purchasePrice) || 0,
          sellingPrice: parseFloat(itemForm.sellingPrice) || 0,
          taxRate: parseFloat(itemForm.taxRate) || 18.0,
          minStockLevel: parseInt(itemForm.minStockLevel, 10) || 5,
        });

        setItems((prev) => prev.map((i) => (i.id === updated.id ? updated : i)));

        if (editingLineIndex !== null && editingLineIndex >= 0 && editingLineIndex < lines.length) {
          const updatedLines = [...lines];
          updatedLines[editingLineIndex] = {
            ...updatedLines[editingLineIndex],
            quantity: parseFloat(itemForm.purchaseQuantity) || updatedLines[editingLineIndex].quantity || 1,
            unitPurchasePrice: Number(updated.purchasePrice) || 0,
            taxRate: Number(updated.taxRate) || 18.0,
          };
          setLines(updatedLines);
        }
      } else {
        // Create new item in catalog
        const created = await api.createItem({
          name: itemForm.name.trim(),
          sku: skuVal,
          category: itemForm.category.trim() || undefined,
          unit: itemForm.unit || 'Pcs',
          purchasePrice: parseFloat(itemForm.purchasePrice) || 0,
          sellingPrice: parseFloat(itemForm.sellingPrice) || parseFloat(itemForm.purchasePrice) || 0,
          taxRate: parseFloat(itemForm.taxRate) || 18.0,
          minStockLevel: parseInt(itemForm.minStockLevel, 10) || 5,
          initialQuantity: 0,
        });

        setItems((prev) => [created, ...prev]);

        const qtyToSet = parseFloat(itemForm.purchaseQuantity) || 1;

        if (targetLineIndex !== null && targetLineIndex >= 0 && targetLineIndex < lines.length) {
          const updatedLines = [...lines];
          updatedLines[targetLineIndex] = {
            itemId: created.id,
            quantity: qtyToSet,
            unitPurchasePrice: Number(created.purchasePrice) || 0,
            taxRate: Number(created.taxRate) || 18.0,
          };
          setLines(updatedLines);
        } else {
          setLines((prev) => [
            ...prev,
            {
              itemId: created.id,
              quantity: qtyToSet,
              unitPurchasePrice: Number(created.purchasePrice) || 0,
              taxRate: Number(created.taxRate) || 18.0,
            },
          ]);
        }
      }

      setShowAddItemModal(false);
      setEditingItem(null);
      setEditingLineIndex(null);
      setTargetLineIndex(null);
    } catch (err: any) {
      alert(err.message || 'Failed to save inventory item');
    } finally {
      setAddingItem(false);
    }
  };

  const handleSubmitPurchase = async (e: React.FormEvent) => {
    if (!selectedVendorId || !invoiceNumber || lines.length === 0) {
      setMessage({
        type: 'error',
        text: 'Please select vendor, invoice number, and add at least one line item.',
      });
      return;
    }

    try {
      setSubmitting(true);
      setMessage(null);

      await api.createPurchase({
        vendorId: selectedVendorId,
        invoiceNumber,
        purchaseDate,
        items: lines,
        isCredit,
      });

      setMessage({
        type: 'success',
        text: '🎉 Purchase entry submitted! Inventory stock & Eligible Input Tax Credit (ITC) updated.',
      });

      // Reset form
      setInvoiceNumber('');
      setLines([]);
      fetchData();
    } catch (err: any) {
      console.error('Failed to process purchase:', err);
      setMessage({
        type: 'error',
        text: err.message || 'Failed to submit purchase entry',
      });
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="flex-1 pb-12">
      <Header
        title="Purchase Entry & ITC Engine"
        subtitle="Record inventory intake from suppliers with per-item GST rates & automated Input Tax Credit (ITC)"
        onRefresh={fetchData}
      />

      <div className="px-8 mt-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* LEFT COLUMN: NEW PURCHASE ENTRY FORM (7 cols) */}
        <div className="lg:col-span-7 glass-card rounded-2xl p-6">
          <div className="flex items-center justify-between border-b border-tally-border pb-4 mb-5">
            <h3 className="font-bold text-base text-white flex items-center gap-2">
              <ShoppingCart className="w-5 h-5 text-blue-400" />
              <span>Record New Vendor Purchase (Line GST)</span>
            </h3>
          </div>

          {message && (
            <div
              className={`mb-6 p-4 rounded-xl text-xs font-medium flex items-center gap-3 ${
                message.type === 'success'
                  ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                  : 'bg-red-500/10 border border-red-500/30 text-red-400'
              }`}
            >
              {message.type === 'success' ? (
                <CheckCircle2 className="w-5 h-5 shrink-0" />
              ) : (
                <AlertTriangle className="w-5 h-5 shrink-0" />
              )}
              <div>{message.text}</div>
            </div>
          )}

          <form onSubmit={handleSubmitPurchase} className="space-y-6 text-xs">
            {/* Vendor, Invoice Number & Purchase Date Grid */}
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <div className="flex items-center justify-between mb-1">
                  <label className="font-medium text-tally-textMuted">
                    Select Supplier Vendor *
                  </label>
                  <button
                    type="button"
                    onClick={() => setShowAddVendorModal(true)}
                    className="text-[11px] text-brand-400 font-bold hover:underline flex items-center gap-0.5 cursor-pointer"
                  >
                    <Plus className="w-3 h-3" /> Add Vendor
                  </button>
                </div>
                <select
                  value={selectedVendorId}
                  onChange={(e) => setSelectedVendorId(e.target.value)}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2.5 text-sm text-white focus:border-brand-500 focus:outline-none"
                >
                  {vendors.map((v) => (
                    <option key={v.id} value={v.id}>
                      {v.name} (Bal: {formatCurrency(v.balance)})
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block font-medium text-tally-textMuted mb-1">
                  Supplier Invoice Ref No. *
                </label>
                <input
                  type="text"
                  required
                  placeholder="e.g. PUR-2026-089"
                  value={invoiceNumber}
                  onChange={(e) => setInvoiceNumber(e.target.value)}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2.5 text-sm text-white font-mono focus:border-brand-500 focus:outline-none"
                />
              </div>

              <div>
                <label className="block font-medium text-tally-textMuted mb-1">
                  Purchase Date (Editable) *
                </label>
                <input
                  type="date"
                  required
                  value={purchaseDate}
                  onChange={(e) => setPurchaseDate(e.target.value)}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2.5 text-sm text-white font-mono focus:border-brand-500 focus:outline-none"
                />
              </div>
            </div>

            {/* Credit Option Checkbox */}
            <div className="flex items-center gap-2 bg-tally-bg/60 p-3 rounded-xl border border-tally-border">
              <input
                type="checkbox"
                id="creditCheck"
                checked={isCredit}
                onChange={(e) => setIsCredit(e.target.checked)}
                className="w-4 h-4 rounded border-tally-border text-brand-500 focus:ring-brand-500 bg-tally-bg"
              />
              <label htmlFor="creditCheck" className="text-xs text-gray-300 font-medium cursor-pointer">
                Purchase on Credit (Increments vendor outstanding balance)
              </label>
            </div>

            {/* LINE ITEMS BUILDER WITH PER-ITEM GST */}
            <div>
              <div className="flex items-center justify-between mb-3">
                <label className="font-semibold text-white">Purchase Item Lines & Tax Rates</label>
                <button
                  type="button"
                  onClick={addLine}
                  className="flex items-center gap-1 text-xs text-brand-400 font-bold hover:underline cursor-pointer"
                >
                  <Plus className="w-3.5 h-3.5" /> Add Item Line
                </button>
              </div>

              {lines.length === 0 ? (
                <div className="py-8 text-center text-tally-textMuted bg-tally-bg/40 rounded-xl border border-dashed border-tally-border space-y-3">
                  <div className="text-xs">Click below or "+ Add Item Line" to restock items</div>
                  <button
                    type="button"
                    onClick={addLine}
                    className="px-4 py-2 rounded-xl bg-brand-500/20 text-brand-400 text-xs font-bold hover:bg-brand-500/30 transition-all border border-brand-500/30 flex items-center gap-1.5 mx-auto cursor-pointer"
                  >
                    <Plus className="w-4 h-4" /> Add Item Line
                  </button>
                </div>
              ) : (
                <div className="space-y-3">
                  {lines.map((line, idx) => {
                    const lineTaxable = (line.quantity || 0) * (line.unitPurchasePrice || 0);
                    const lineTax = lineTaxable * ((line.taxRate || 18) / 100);
                    const lineTotal = lineTaxable + lineTax;
                    const currentSelected = items.find((i) => i.id === line.itemId);

                    return (
                      <div
                        key={idx}
                        className="p-3 bg-tally-bg rounded-xl border border-tally-border space-y-2"
                      >
                        <div className="grid grid-cols-12 gap-3 items-center">
                          <div className="col-span-4">
                            <div className="flex items-center justify-between mb-0.5">
                              <label className="block text-[10px] text-tally-textMuted font-medium">Select Item *</label>
                              <div className="flex items-center gap-2">
                                {currentSelected && (
                                  <button
                                    type="button"
                                    onClick={() => openEditItemModal(currentSelected, idx)}
                                    className="text-[10px] text-blue-400 font-medium hover:underline flex items-center gap-0.5 cursor-pointer"
                                    title="Edit item catalog details"
                                  >
                                    <Pencil className="w-2.5 h-2.5" /> Edit
                                  </button>
                                )}
                                <button
                                  type="button"
                                  onClick={() => openAddItemModal(idx)}
                                  className="text-[10px] text-brand-400 font-bold hover:underline flex items-center gap-0.5 cursor-pointer"
                                >
                                  <Plus className="w-2.5 h-2.5" /> Add New Item
                                </button>
                              </div>
                            </div>
                            <select
                              value={line.itemId}
                              onChange={(e) => updateLine(idx, 'itemId', e.target.value)}
                              className="w-full bg-tally-card border border-tally-border rounded-lg px-2.5 py-1.5 text-xs text-white"
                            >
                              {items.map((item) => (
                                <option key={item.id} value={item.id}>
                                  {item.name} ({item.sku})
                                </option>
                              ))}
                            </select>
                          </div>

                           <div className="col-span-2">
                            <label className="block text-[10px] text-tally-textMuted mb-0.5">Quantity ({currentSelected?.unit || 'Pcs'})</label>
                            <input
                              type="number"
                              min="1"
                              value={line.quantity}
                              onChange={(e) => updateLine(idx, 'quantity', e.target.value)}
                              className="w-full bg-tally-card border border-tally-border rounded-lg px-2.5 py-1.5 text-xs text-white font-mono"
                            />
                          </div>

                          <div className="col-span-3">
                            <label className="block text-[10px] text-tally-textMuted mb-0.5">Unit Price (₹)</label>
                            <input
                              type="number"
                              step="0.01"
                              value={line.unitPurchasePrice}
                              onChange={(e) => updateLine(idx, 'unitPurchasePrice', e.target.value)}
                              className="w-full bg-tally-card border border-tally-border rounded-lg px-2.5 py-1.5 text-xs text-white font-mono"
                            />
                          </div>

                          <div className="col-span-2">
                            <label className="block text-[10px] text-tally-textMuted mb-0.5">GST Rate %</label>
                            <input
                              type="number"
                              step="0.01"
                              value={line.taxRate}
                              onChange={(e) => updateLine(idx, 'taxRate', e.target.value)}
                              className="w-full bg-tally-card border border-tally-border rounded-lg px-2 py-1.5 text-xs text-white font-mono"
                            />
                          </div>

                          <div className="col-span-1 text-right pt-4">
                            <button
                              type="button"
                              onClick={() => removeLine(idx)}
                              className="text-gray-500 hover:text-red-400"
                            >
                              <Trash2 className="w-4 h-4" />
                            </button>
                          </div>
                        </div>

                        {/* Calculated Breakdown Line */}
                        <div className="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-tally-border/40 px-1">
                          <span>Taxable: {formatCurrency(lineTaxable)}</span>
                          <span className="text-blue-400">+ GST ({line.taxRate}%): {formatCurrency(lineTax)} (ITC)</span>
                          <span className="font-bold text-white">Line Total: {formatCurrency(lineTotal)}</span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Total Summary Breakdown */}
            <div className="p-4 rounded-xl bg-tally-bg/80 border border-tally-border space-y-2">
              <div className="flex justify-between text-xs text-gray-300">
                <span>Total Taxable Amount:</span>
                <span className="font-mono text-white">{formatCurrency(totalTaxable)}</span>
              </div>
              <div className="flex justify-between text-xs text-blue-400">
                <span>Eligible Input Tax Credit (ITC):</span>
                <span className="font-mono font-bold">+{formatCurrency(totalTaxAmount)}</span>
              </div>
              <div className="flex justify-between border-t border-tally-border pt-2 text-base font-bold text-white">
                <span>Total Purchase Cost:</span>
                <span className="font-mono text-blue-400 text-xl">{formatCurrency(totalPurchaseAmount)}</span>
              </div>
            </div>

            <button
              type="submit"
              disabled={submitting || lines.length === 0}
              className={`w-full py-3.5 px-6 rounded-xl font-bold text-sm flex items-center justify-center gap-2 shadow-lg transition-all ${
                lines.length === 0 || submitting
                  ? 'bg-tally-border text-gray-500 cursor-not-allowed'
                  : 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-600/25'
              }`}
            >
              <ShoppingCart className="w-4 h-4" />
              <span>{submitting ? 'Recording Entry...' : 'Submit & Restock Inventory'}</span>
            </button>
          </form>
        </div>

        {/* RIGHT COLUMN: RECENT PURCHASES HISTORY (5 cols) */}
        <div className="lg:col-span-5 glass-card rounded-2xl p-6">
          <div className="flex items-center justify-between border-b border-tally-border pb-4 mb-4">
            <h3 className="font-bold text-base text-white">Purchase History Ledger</h3>
          </div>

          {loading ? (
            <div className="py-8 text-center text-sm text-tally-textMuted">Loading history...</div>
          ) : purchases.length === 0 ? (
            <div className="py-8 text-center text-sm text-tally-textMuted">No purchase entries recorded yet.</div>
          ) : (
            <div className="space-y-4">
              {purchases.map((purchase) => (
                <div
                  key={purchase.id}
                  className="p-4 rounded-xl bg-tally-bg/70 border border-tally-border space-y-2"
                >
                  <div className="flex items-center justify-between">
                    <span className="font-mono text-xs font-bold text-blue-400">
                      {purchase.invoiceNumber}
                    </span>
                    <span className="font-mono font-bold text-sm text-white">
                      {formatCurrency(purchase.totalAmount)}
                    </span>
                  </div>

                  <div className="flex items-center gap-2 text-xs text-gray-300">
                    <Building className="w-3.5 h-3.5 text-gray-500" />
                    <span className="font-semibold">{purchase.vendor?.name || 'Vendor'}</span>
                  </div>

                  <div className="text-[11px] text-tally-textMuted flex items-center justify-between pt-1 border-t border-tally-border/40">
                    <span>{purchase.items.length} Items Restocked</span>
                    <span>{new Date(purchase.purchaseDate).toLocaleDateString()}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* QUICK ADD VENDOR MODAL */}
      {showAddVendorModal && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm p-4 flex justify-center items-center">
          <div className="bg-tally-card border border-tally-border rounded-2xl max-w-md w-full p-6 shadow-2xl relative space-y-4">
            <div className="flex items-center justify-between border-b border-tally-border pb-3">
              <h3 className="font-bold text-sm text-white flex items-center gap-2">
                <Building className="w-4 h-4 text-brand-400" />
                <span>+ Add New Supplier Vendor</span>
              </h3>
              <button
                type="button"
                onClick={() => setShowAddVendorModal(false)}
                className="text-gray-400 hover:text-white"
              >
                ✕
              </button>
            </div>

            <form onSubmit={handleAddVendorSubmit} className="space-y-4 text-xs">
              <div>
                <label className="block font-medium text-tally-textMuted mb-1">Vendor / Company Name *</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Acme Supplies Pvt Ltd"
                  value={newVendorForm.name}
                  onChange={(e) => setNewVendorForm({ ...newVendorForm, name: e.target.value })}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-sm"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Phone Number</label>
                  <input
                    type="text"
                    placeholder="+91 98000 00000"
                    value={newVendorForm.phone}
                    onChange={(e) => setNewVendorForm({ ...newVendorForm, phone: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">GSTIN</label>
                  <input
                    type="text"
                    placeholder="07AAAAA0000A1Z5"
                    value={newVendorForm.gstin}
                    onChange={(e) => setNewVendorForm({ ...newVendorForm, gstin: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono uppercase focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
              </div>

              <div>
                <label className="block font-medium text-tally-textMuted mb-1">Office / Factory Address</label>
                <textarea
                  rows={2}
                  placeholder="Enter vendor address..."
                  value={newVendorForm.address}
                  onChange={(e) => setNewVendorForm({ ...newVendorForm, address: e.target.value })}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-xs resize-none"
                />
              </div>

              <div className="flex items-center justify-end gap-3 pt-2">
                <button
                  type="button"
                  onClick={() => setShowAddVendorModal(false)}
                  className="px-4 py-2 rounded-xl bg-tally-bg border border-tally-border text-gray-300 font-bold hover:text-white"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={addingVendor || !newVendorForm.name.trim()}
                  className="px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-tally-bg font-bold shadow-md cursor-pointer disabled:opacity-50"
                >
                  {addingVendor ? 'Creating...' : 'Save & Select Vendor'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* QUICK ADD / EDIT ITEM MODAL */}
      {showAddItemModal && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm p-4 flex justify-center items-center">
          <div className="bg-tally-card border border-tally-border rounded-2xl max-w-lg w-full p-6 shadow-2xl relative space-y-4">
            <div className="flex items-center justify-between border-b border-tally-border pb-3">
              <h3 className="font-bold text-sm text-white flex items-center gap-2">
                <Boxes className="w-4 h-4 text-emerald-400" />
                <span>{editingItem ? '✏️ Edit Inventory Item Details' : '📦 Add New Inventory Item to Catalog'}</span>
              </h3>
              <button
                type="button"
                onClick={() => setShowAddItemModal(false)}
                className="text-gray-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleItemSubmit} className="space-y-4 text-xs">
              <div>
                <label className="block font-medium text-tally-textMuted mb-1">Item Name *</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Wireless Ergonomic Mouse"
                  value={itemForm.name}
                  onChange={(e) => setItemForm({ ...itemForm, name: e.target.value })}
                  className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-sm"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">SKU / Code *</label>
                  <input
                    type="text"
                    required
                    placeholder="e.g. SKU-98230"
                    value={itemForm.sku}
                    onChange={(e) => setItemForm({ ...itemForm, sku: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Category / HSN</label>
                  <input
                    type="text"
                    placeholder="e.g. Electronics / 8471"
                    value={itemForm.category}
                    onChange={(e) => setItemForm({ ...itemForm, category: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Unit of Measure</label>
                  <select
                    value={itemForm.unit}
                    onChange={(e) => setItemForm({ ...itemForm, unit: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white focus:outline-none focus:border-brand-500 text-xs"
                  >
                    <option value="Pcs">Pcs (Pieces)</option>
                    <option value="Box">Box</option>
                    <option value="Kg">Kg (Kilograms)</option>
                    <option value="Ltr">Ltr (Liters)</option>
                    <option value="Mtr">Mtr (Meters)</option>
                    <option value="Set">Set</option>
                    <option value="Pkt">Pkt (Packet)</option>
                  </select>
                </div>

                <div>
                  <label className="block font-medium text-emerald-400 mb-1">Purchase Quantity ({itemForm.unit}) *</label>
                  <input
                    type="number"
                    step="0.01"
                    min="0.01"
                    required
                    placeholder="e.g. 10"
                    value={itemForm.purchaseQuantity}
                    onChange={(e) => setItemForm({ ...itemForm, purchaseQuantity: e.target.value })}
                    className="w-full bg-tally-bg border border-emerald-500/50 rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-emerald-500 text-xs font-bold"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Purchase Price (Cost ₹) *</label>
                  <input
                    type="number"
                    step="0.01"
                    required
                    placeholder="0.00"
                    value={itemForm.purchasePrice}
                    onChange={(e) => setItemForm({ ...itemForm, purchasePrice: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>

                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Selling Price (MRP ₹) *</label>
                  <input
                    type="number"
                    step="0.01"
                    required
                    placeholder="0.00"
                    value={itemForm.sellingPrice}
                    onChange={(e) => setItemForm({ ...itemForm, sellingPrice: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">GST Tax Rate (%)</label>
                  <select
                    value={itemForm.taxRate}
                    onChange={(e) => setItemForm({ ...itemForm, taxRate: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-brand-500 text-xs"
                  >
                    <option value="0">0% (Exempt)</option>
                    <option value="5">5% GST</option>
                    <option value="12">12% GST</option>
                    <option value="18">18% GST (Standard)</option>
                    <option value="28">28% GST</option>
                  </select>
                </div>

                <div>
                  <label className="block font-medium text-tally-textMuted mb-1">Min Stock Alert Level</label>
                  <input
                    type="number"
                    placeholder="5"
                    value={itemForm.minStockLevel}
                    onChange={(e) => setItemForm({ ...itemForm, minStockLevel: e.target.value })}
                    className="w-full bg-tally-bg border border-tally-border rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-brand-500 text-xs"
                  />
                </div>
              </div>

              <div className="flex items-center justify-end gap-3 pt-3 border-t border-tally-border">
                <button
                  type="button"
                  onClick={() => setShowAddItemModal(false)}
                  className="px-4 py-2 rounded-xl bg-tally-bg border border-tally-border text-gray-300 font-bold hover:text-white"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={addingItem || !itemForm.name.trim()}
                  className="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-tally-bg font-bold shadow-md cursor-pointer disabled:opacity-50 flex items-center gap-1.5"
                >
                  {addingItem ? 'Saving...' : editingItem ? 'Update Item Details' : 'Save & Select Item'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
