{
  "name": "@tally/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
